PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
TELEMETRY_IP_SALT=replace-with-a-separate-long-random-secret
# App runtime connection. Locally, just your local Postgres instance.
# In production (Supabase), use the Session Pooler or Transaction Pooler
# connection string (aws-0-<region>.pooler.supabase.com) -- Supabase's
# direct "db.<project-ref>.supabase.co" host is IPv6-only and unreachable
# from hosts (like Render) that only have IPv4 egress.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empower_recovery
# Connection used by `prisma migrate deploy`/`migrate dev`. Locally this
# can just match DATABASE_URL. In production, use Supabase's Session
# Pooler connection string (port 5432) -- migrations need prepared
# statement/advisory lock support that the Transaction Pooler (6543)
# doesn't provide.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/empower_recovery
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to localhost:5173 + the production Vercel URL if unset.
ALLOWED_ORIGINS=http://localhost:5173,https://empower-recovery.vercel.app
